{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/properties/:slug",
      "destination": "/property"
    }
  ],
  "redirects": [
    {
      "source": "/properties",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/saved",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/explore",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rentals",
      "destination": "/?purpose=rent",
      "permanent": true
    },
    {
      "source": "/land",
      "destination": "/?type=land",
      "permanent": true
    },
    {
      "source": "/short-stays",
      "destination": "/?purpose=short_stay",
      "permanent": true
    },
    {
      "source": "/commercial",
      "destination": "/?type=commercial",
      "permanent": true
    },
    {
      "source": "/account/saved",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sign-in",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sign-up",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/verify",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/verify-phone",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/onboarding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/account",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/account/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inbox",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inbox/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portal",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portal/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ops",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ops/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/providers/:slug",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/compare",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/trust-and-verification",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/auth/callback",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/invitations/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/suspended",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "baid-atlas.vercel.app"
        }
      ],
      "destination": "https://propertiq-gh.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "baid-atlas-missoluadeoye-5587.vercel.app"
        }
      ],
      "destination": "https://propertiq-gh.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.maptiler.com; font-src 'self'; connect-src 'self' https://api.maptiler.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://my.matterport.com https://kuula.co https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
