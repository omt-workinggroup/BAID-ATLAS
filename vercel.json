{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/properties/:slug",
      "destination": "/property"
    },
    {
      "source": "/providers/:slug",
      "destination": "/provider"
    },
    {
      "source": "/inbox/:id",
      "destination": "/conversation"
    },
    {
      "source": "/portal/new",
      "destination": "/portal-new"
    },
    {
      "source": "/portal/:org/team",
      "destination": "/team"
    },
    {
      "source": "/portal/:org/settings",
      "destination": "/org-settings"
    },
    {
      "source": "/portal/:org/leads/:id",
      "destination": "/lead"
    },
    {
      "source": "/portal/:org/leads",
      "destination": "/leads"
    },
    {
      "source": "/portal/:org/listings/new",
      "destination": "/listing-new"
    },
    {
      "source": "/portal/:org/listings/:id",
      "destination": "/listing-edit"
    },
    {
      "source": "/portal/:org/listings",
      "destination": "/listings"
    },
    {
      "source": "/portal/:org",
      "destination": "/org"
    },
    {
      "source": "/ops/reviews/:id",
      "destination": "/ops-review"
    },
    {
      "source": "/ops/organisations",
      "destination": "/ops-orgs"
    },
    {
      "source": "/ops/reports",
      "destination": "/ops-reports"
    }
  ],
  "redirects": [
    {
      "source": "/rentals",
      "destination": "/explore?purpose=long_term_rent",
      "permanent": false
    },
    {
      "source": "/land",
      "destination": "/explore?type=land",
      "permanent": false
    },
    {
      "source": "/short-stays",
      "destination": "/explore?purpose=short_stay",
      "permanent": false
    },
    {
      "source": "/commercial",
      "destination": "/explore?type=commercial",
      "permanent": false
    },
    {
      "source": "/account/saved",
      "destination": "/saved",
      "permanent": true
    },
    {
      "source": "/verify-phone",
      "destination": "/verify",
      "permanent": true
    },
    {
      "source": "/portal/:org/organisation",
      "destination": "/portal/:org/settings",
      "permanent": true
    },
    {
      "source": "/account/suspended",
      "destination": "/suspended",
      "permanent": true
    },
    {
      "source": "/auth/callback",
      "destination": "/sign-in?error=link",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "baid-atlas-missoluadeoye-5587.vercel.app"
        }
      ],
      "destination": "https://baid-atlas.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://ecikayrsbjzgdjkehnhl.supabase.co https://api.maptiler.com; font-src 'self'; connect-src 'self' https://ecikayrsbjzgdjkehnhl.supabase.co wss://ecikayrsbjzgdjkehnhl.supabase.co https://api.maptiler.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
